---
layout: default
---
<div class="handbook">
  <div class="row">
    <div class="col-sm-3">
      <nav id="handbook-toc" class="handbook-toc sticky-top">
        <div class="handbook-toc-title">Lab Handbook</div>
        <ul class="handbook-toc-list">
          {% for section in site.data.handbook %}
            {% assign section_url = "/resources/handbook/" | append: section.slug | append: "/" | relative_url %}
            <li class="handbook-toc-section">
              <a href="{{ section_url }}" class="handbook-toc-section-link{% if page.handbook_slug == section.slug %} current{% endif %}">{{ section.title }}</a>
              <ul class="handbook-toc-subsections">
                {% for sub in section.subsections %}
                  <li>
                    <a href="{{ section_url }}#{{ sub.anchor }}" class="handbook-toc-sub-link" data-anchor="{{ sub.anchor }}">{{ sub.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
    <div class="col-sm-9">
      <article class="handbook-content">
        <h1 class="post-title">{{ page.title }}</h1>
        {% if page.updated %}
          <p class="handbook-updated"><em>Last updated {{ page.updated }}</em></p>
        {% endif %}
        {{ content }}
      </article>
    </div>
  </div>
</div>
<script defer src="{{ '/assets/js/handbook.js' | relative_url | bust_file_cache }}"></script>
