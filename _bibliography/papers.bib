@comment{
  Add your lab's publications below as standard BibTeX entries.
  jekyll-scholar renders this file automatically on the /publications/ page.

  Example:

  @article{smith2024example,
    abbr = {Journal},
    title = {An example paper title},
    author = {Smith, Jane and Piacentino, Michael},
    journal = {Journal Name},
    volume = {1},
    pages = {1--10},
    year = {2024},
    selected = {true},
    pdf = {example.pdf},
    preview = {example.jpg}
  }
}
